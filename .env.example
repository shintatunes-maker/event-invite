# Leave both unset for local dev — falls back to a local SQLite file at data/app.db.
# For production (Vercel), create a Turso database and set these:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stripe secret key (test mode: sk_test_...). Required for the watermark
# removal purchase flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site origin, used to resolve absolute OGP image URLs.
# Leave unset for local dev (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Google Maps API key with the Places API enabled, used for address
# autocomplete on the 場所 field in /create and /event/[id]/manage/edit.
# Optional — leave unset and those fields fall back to plain text input.
# This key is exposed to the browser (NEXT_PUBLIC_*), so restrict it to
# your site's domain(s) under "Application restrictions" in Google Cloud
# Console rather than treating it as a secret.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
